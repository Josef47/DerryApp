rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isLoggedIn() {
      return request.auth != null;
    }

    function isHousemaster() {
      return isLoggedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isHousemaster == true;
    }

    function isOwner(userId) {
      return isLoggedIn() && request.auth.uid == userId;
    }

    // One-time keys: public read for login, HM write
    match /oneTimeKeys/{keyId} {
      allow read: if true;
      allow write: if isLoggedIn();
    }

    // Users: logged-in can read, HM can write
    match /users/{userId} {
      allow read: if isLoggedIn();
      allow create, update: if isLoggedIn();
      allow delete: if isHousemaster();
    }

    // Tasks: logged-in read, HM create/edit/delete
    match /tasks/{taskId} {
      allow read: if isLoggedIn();
      allow write: if isHousemaster();
    }

    // Completions: logged-in read/write own completions
    match /completions/{compId} {
      allow read: if isLoggedIn();
      allow create: if isLoggedIn();
      allow delete: if isLoggedIn();
    }

    // Activity types: logged-in read, HM write
    match /activityTypes/{typeId} {
      allow read: if isLoggedIn();
      allow write: if isHousemaster();
    }

    // Activity logs: logged-in read, owner create
    match /activityLogs/{logId} {
      allow read: if isLoggedIn();
      allow create: if isLoggedIn();
      allow update: if false; // only Cloud Functions update syncedToDrive
    }

    // Finance: all logged-in can read + create; HM can delete/edit
    match /financeEntries/{entryId} {
      allow read: if isLoggedIn();
      allow create: if isLoggedIn();
      allow update, delete: if isHousemaster() || isOwner(resource.data.userId);
    }

    match /financeBalance/{docId} {
      allow read: if isLoggedIn();
      allow write: if isLoggedIn(); // balance updated by Cloud Functions / direct
    }

    // Shopping: all logged-in read/write
    match /shoppingItems/{itemId} {
      allow read, write: if isLoggedIn();
    }

    match /shoppingCategories/{catId} {
      allow read: if isLoggedIn();
      allow write: if isHousemaster();
    }

    match /loyaltyCards/{cardId} {
      allow read: if isLoggedIn();
      allow create: if isLoggedIn();
      allow delete: if isLoggedIn();
    }

    // Drive links
    match /driveLinks/{linkId} {
      allow read: if isLoggedIn();
      allow write: if isHousemaster();
    }

    // Settings: logged-in read, HM write
    match /settings/{docId} {
      allow read: if isLoggedIn();
      allow write: if isHousemaster();
    }
  }
}
